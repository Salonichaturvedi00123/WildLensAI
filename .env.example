# WildLensAI Environment Configuration

# Django Secret Key (Generate a unique, unpredictable secret for your environment)
SECRET_KEY=django-insecure-replace-with-a-secure-random-key-in-production

# Debug Mode (True for local development, False for production)
DEBUG=True

# Allowed Hosts (Comma-separated hostnames or IP addresses for local/LAN dev)
ALLOWED_HOSTS=127.0.0.1,localhost

# CSRF Trusted Origins (Optional: comma-separated origins for mobile testing over LAN or HTTPS tunnels)
# Example: CSRF_TRUSTED_ORIGINS=https://your-tunnel-name.ngrok-free.app,http://192.168.1.100:8000
CSRF_TRUSTED_ORIGINS=

# Google Gemini API Key (Required for Phase 2/3 LangGraph AI Wildlife Agent)
# Obtain from Google AI Studio: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Razorpay Test Mode Configuration (Required for Phase 2+ Payment Integration)
# Obtain Test API Keys from Razorpay Dashboard: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_test_key_here
RAZORPAY_KEY_SECRET=your_test_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
RAZORPAY_MODE=test

