# WildLensAI Environment Configuration

# Local Windows development settings. Do not use these defaults in production.
DJANGO_ENV=development
DATA_DIR=
SECRET_KEY=django-insecure-local-development-only

# Debug Mode
DEBUG=True

# Allowed Hosts (comma-separated hostnames or IP addresses)
ALLOWED_HOSTS=127.0.0.1,localhost

# CSRF Trusted Origins (comma-separated origins for local HTTPS/tunnel testing)
# Example: CSRF_TRUSTED_ORIGINS=https://your-tunnel-name.ngrok-free.app,http://192.168.1.100:8000
CSRF_TRUSTED_ORIGINS=

# Google Gemini API Key (Required for Phase 2/3 LangGraph AI Wildlife Agent)
# Obtain from Google AI Studio: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Razorpay Test Mode Configuration (local development)
# Obtain Test API Keys from Razorpay Dashboard: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_test_key_here
RAZORPAY_KEY_SECRET=your_test_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
RAZORPAY_MODE=test

# Production-only Render environment variables are set in the Render dashboard:
# DJANGO_ENV=production
# DATA_DIR=/var/data
# SQLITE_DB_PATH=/var/data/db.sqlite3
# MEDIA_ROOT=/var/data/media
# DEBUG=False
# SECRET_KEY=<generated random secret, at least 50 characters>
# ALLOWED_HOSTS=<service>.onrender.com,your-domain.example
# CSRF_TRUSTED_ORIGINS=https://<service>.onrender.com,https://your-domain.example
# GOOGLE_API_KEY=<Google Gemini API key> (or GEMINI_API_KEY)
# RAZORPAY_KEY_ID=<Razorpay key ID>
# RAZORPAY_KEY_SECRET=<Razorpay key secret>
# RAZORPAY_WEBHOOK_SECRET=<Razorpay webhook secret>
# RAZORPAY_MODE=test

